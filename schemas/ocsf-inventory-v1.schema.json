{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignatg.github.io/infraharvest/schemas/ocsf-inventory-v1.schema.json",
  "title": "infraharvest OCSF inventory, version 1",
  "description": "The resources of the inventory document as OCSF 1.9.0 Cloud Resources Inventory Info events (class_uid 5023), one event for each resource, with the infraharvest iac extension's iac_source profile (schemas/ocsf/iac). It describes the subset of the OCSF class that infraharvest writes, not all of it. No attributes and no values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "ocsf_version", "events"],
  "properties": {
    "schema": {"const": "infraharvest/ocsf-inventory/v1"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "ocsf_version": {"const": "1.9.0"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "text": {"type": "string", "minLength": 1},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "activity_name", "category_name", "category_uid", "class_name", "class_uid", "cloud", "metadata", "resources", "severity_id", "time", "type_uid"],
      "properties": {
        "activity_id": {"const": 2},
        "activity_name": {"const": "Collect"},
        "category_name": {"const": "Discovery"},
        "category_uid": {"const": 5},
        "class_name": {"const": "Cloud Resources Inventory Info"},
        "class_uid": {"const": 5023},
        "severity_id": {"const": 1},
        "time": {"type": "integer", "minimum": 0},
        "type_uid": {"const": 502302},
        "metadata": {"$ref": "#/$defs/metadata"},
        "cloud": {"$ref": "#/$defs/cloud"},
        "resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resource_details"}}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_uid", "extensions", "product", "profiles", "version"],
      "properties": {
        "version": {"const": "1.9.0"},
        "correlation_uid": {"$ref": "#/$defs/uuid"},
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "infraharvest"},
            "version": {"$ref": "#/$defs/text"}
          }
        },
        "profiles": {"const": ["cloud", "iac/iac_source"]},
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "uid", "version"],
            "properties": {
              "name": {"const": "iac"},
              "uid": {"const": "1301"},
              "version": {"const": "1.0.0"}
            }
          }
        }
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {"enum": ["AWS", "Azure", "GCP"]},
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uid"],
          "properties": {"uid": {"$ref": "#/$defs/text"}}
        },
        "region": {"$ref": "#/$defs/text"}
      }
    },
    "resource_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uid"],
      "properties": {
        "type": {"$ref": "#/$defs/text"},
        "uid": {"$ref": "#/$defs/text"},
        "name": {"$ref": "#/$defs/text"},
        "region": {"$ref": "#/$defs/text"},
        "labels": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {"name": {"$ref": "#/$defs/text"}, "value": {"type": "string"}}
          }
        },
        "iac": {"$ref": "#/$defs/iac_source"}
      }
    },
    "iac_source": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tool": {"enum": ["terraform", "opentofu"]},
        "address": {"$ref": "#/$defs/text"},
        "module_address": {"$ref": "#/$defs/text"},
        "repo_url": {"type": "string", "pattern": "^https?://[^\\s@/?#]+(/[^\\s?#]*)?$"},
        "commit_sha": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "path": {"$ref": "#/$defs/text"},
        "workspace": {"$ref": "#/$defs/text"},
        "state_key": {"$ref": "#/$defs/text"}
      }
    }
  }
}
