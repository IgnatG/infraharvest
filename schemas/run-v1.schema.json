{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignatg.github.io/infraharvest/schemas/run-v1.schema.json",
  "title": "infraharvest run, version 1",
  "description": "What infraharvest export writes of one run of a command that leaves something to describe it by: import, drift, discover or verify. Its command and outcome; for an import also its exit code, the tool and engine versions and the coverage counts. No resources and no messages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "command", "outcome"],
  "properties": {
    "schema": {"const": "infraharvest/run/v1"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "command": {"enum": ["import", "drift", "discover", "verify"]},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
    "outcome": {"enum": ["ok", "partial", "failed", "interrupted"]},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "tool": {"$ref": "#/$defs/component"},
    "engine": {"$ref": "#/$defs/component"},
    "coverage": {"$ref": "#/$defs/counts"},
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["run_failed", "resources_left_out", "resources_failed", "check_failed", "interrupted", "roots_not_checked"]}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"command": {"const": "import"}}, "required": ["command"]},
      "then": {"required": ["exit_code", "tool", "engine", "coverage"]}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "count": {"type": "integer", "minimum": 0},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "imported", "left_out", "skipped", "excluded", "failed", "managed", "other_tool", "cloud"],
      "properties": {
        "discovered": {"$ref": "#/$defs/count"},
        "imported": {"$ref": "#/$defs/count"},
        "left_out": {"$ref": "#/$defs/count"},
        "skipped": {"$ref": "#/$defs/count"},
        "excluded": {"$ref": "#/$defs/count"},
        "failed": {"$ref": "#/$defs/count"},
        "managed": {"$ref": "#/$defs/count"},
        "other_tool": {"$ref": "#/$defs/count"},
        "cloud": {"$ref": "#/$defs/count"}
      }
    }
  }
}
