{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignatg.github.io/infraharvest/schemas/graph-v1.schema.json",
  "title": "infraharvest graph, version 1",
  "description": "What infraharvest export writes of how the imported resources fit together: a node for each imported resource, named as the inventory names it, and for each module call, named by its registry source alone; an edge for each reference the generated configuration writes between them. No addresses, names, paths, attributes or values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "generated_at", "tool", "cloud", "nodes", "edges", "redaction"],
  "properties": {
    "schema": {"const": "infraharvest/graph/v1"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "tool": {"$ref": "#/$defs/component"},
    "cloud": {"enum": ["aws", "azure", "google"]},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "redaction": {"$ref": "#/$defs/redaction"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "index": {"type": "integer", "minimum": 0},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "account"],
      "properties": {
        "kind": {"enum": ["resource", "module"]},
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "account": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parent": {"$ref": "#/$defs/index"}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "resource"}}, "required": ["type", "id"], "not": {"anyOf": [{"required": ["source"]}, {"required": ["version"]}]}},
        {"properties": {"kind": {"const": "module"}}, "required": ["source"], "not": {"anyOf": [{"required": ["type"]}, {"required": ["id"]}, {"required": ["parent"]}]}}
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/index"},
        "to": {"$ref": "#/$defs/index"}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids_hashed", "hash_alg"],
      "properties": {
        "ids_hashed": {"type": "boolean"},
        "hash_alg": {"const": "hmac-sha256"}
      }
    }
  }
}
