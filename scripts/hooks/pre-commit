# Runs the fast checks on what this commit stages (see scripts/fast-checks.sh).
# Enable the hooks with `make hooks`, or
#   git config core.hooksPath scripts/hooks
set -euo pipefail
exec "$(git rev-parse --show-toplevel)/scripts/fast-checks.sh" --staged
