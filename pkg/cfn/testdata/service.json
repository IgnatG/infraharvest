{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "A function that writes to a bucket, with its role and log group.",
  "Parameters": {
    "FunctionName": {
      "Type": "String",
      "MinLength": "1",
      "MaxLength": "64"
    },
    "MemorySize": {
      "Type": "Number",
      "Default": 256,
      "AllowedValues": [128, 256, 512]
    },
    "ApiKey": {
      "Type": "String",
      "NoEcho": true,
      "Default": "not-a-real-key"
    },
    "EnableTracing": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["true", "false"]
    }
  },
  "Conditions": {
    "Tracing": {"Fn::Equals": [{"Ref": "EnableTracing"}, "true"]},
    "Large": {"Fn::Or": [{"Fn::Equals": [{"Ref": "MemorySize"}, 512]}, {"Condition": "Tracing"}]}
  },
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {"Fn::Sub": "${FunctionName}-${AWS::AccountId}-output"},
        "VersioningConfiguration": {"Status": "Enabled"},
        "Tags": [
          {"Key": "app", "Value": {"Ref": "FunctionName"}},
          {"Fn::If": ["Tracing", {"Key": "tracing", "Value": "on"}, {"Ref": "AWS::NoValue"}]}
        ]
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": {"Service": "lambda.amazonaws.com"},
            "Action": "sts:AssumeRole",
            "Condition": {"StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}}}
          }]
        },
        "ManagedPolicyArns": [
          {"Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"}
        ],
        "Policies": [{
          "PolicyName": "write-output",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [{
              "Effect": "Allow",
              "Action": ["s3:PutObject"],
              "Resource": {"Fn::Sub": "${Bucket.Arn}/*"}
            }]
          }
        }]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/${FunctionName}"},
        "RetentionInDays": {"Fn::If": ["Large", 30, 7]}
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": ["Logs"],
      "Properties": {
        "FunctionName": {"Ref": "FunctionName"},
        "Runtime": "python3.13",
        "Handler": "app.handler",
        "Role": {"Fn::GetAtt": ["Role", "Arn"]},
        "MemorySize": {"Ref": "MemorySize"},
        "Code": {"S3Bucket": "artifacts", "S3Key": "app.zip"},
        "Environment": {
          "Variables": {
            "BUCKET": {"Ref": "Bucket"},
            "API_KEY": {"Ref": "ApiKey"},
            "SHARED_TABLE": {"Fn::ImportValue": {"Fn::Sub": "${AWS::Region}-SharedTable"}}
          }
        },
        "TracingConfig": {"Fn::If": ["Tracing", {"Mode": "Active"}, {"Ref": "AWS::NoValue"}]}
      }
    },
    "Schedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(1 hour)",
        "EventPattern": {"source": ["aws.s3"]},
        "Targets": [{"Arn": {"Fn::GetAtt": ["Function", "Arn"]}, "Id": "function"}]
      }
    }
  },
  "Outputs": {
    "FunctionArn": {
      "Value": {"Fn::GetAtt": ["Function", "Arn"]},
      "Export": {"Name": "service-function-arn"}
    },
    "ApiKey": {
      "Value": {"Ref": "ApiKey"}
    },
    "TracingNote": {
      "Condition": "Tracing",
      "Value": {"Fn::If": ["Large", "large and traced", "traced"]}
    }
  }
}
